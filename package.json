{
  "name": "cleanly",
  "private": true,
  "version": "4.2.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n CLIENT,SERVER -c cyan,magenta \"npm run client\" \"npm run server\"",
    "client": "vite",
    "server": "node --watch server/index.js",
    "build": "vite build",
    "preview": "node server/index.js",
    "seed": "node server/seed.js",
    "db:schema": "psql $DATABASE_URL -f schema.sql",
    "build:app": "vite build && npx cap sync android",
    "seed:prod": "node server/seed-prod.js",
    "test:render": "vite build --minify false && node scripts/smoke-render.mjs",
    "test:e2e": "node test/e2e.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@capacitor/ios": "^6.2.1",
    "stripe": "^16.12.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.2.1",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "playwright": "^1.60.0",
    "qrcode": "^1.5.4",
    "vite": "^5.4.0",
    "jsdom": "^24.0.0",
    "pg-mem": "^2.8.1"
  },
  "engines": {
    "node": ">=20"
  }
}