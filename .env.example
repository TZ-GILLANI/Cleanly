# ── Copy this file to .env and fill in your values ───────────

# PostgreSQL connection string
# Local:  postgresql://postgres:yourpassword@localhost:5432/cleanly
# Remote: postgresql://user:pass@host:5432/cleanly?sslmode=require
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/cleanly

# Generate a strong secret:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string-in-production

# Server port (default 3001)
PORT=3001
NODE_ENV=development

# ── Frontend ─────────────────────────────────────────────────
# Set to 'true' to use the Express backend instead of demo mode
VITE_USE_API=true

# ── Payments (Hungarian processors) ──────────────────────────
# Choose ONE provider, create a (sandbox first) merchant account, paste keys.
#
# SimplePay (OTP Mobil) — https://sandbox.simplepay.hu
PAYMENT_PROVIDER=simplepay            # 'simplepay' | 'barion' | 'none'
SIMPLEPAY_MERCHANT=
SIMPLEPAY_SECRET_KEY=
SIMPLEPAY_SANDBOX=true
#
# Barion — https://www.barion.com (Sandbox: https://sandbox.barion.com)
BARION_POSKEY=
BARION_PIXEL_ID=
BARION_SANDBOX=true

# ── Barion (recommended: faster approval than SimplePay) ─────
# Sandbox: create a free account at sandbox.barion.com → My shops → POSKey
# Live:    barion.com merchant account (needs your Kft), then BARION_ENV=prod
BARION_ENV=test
BARION_POSKEY=
BARION_PAYEE=your-barion-account-email@example.com

# ── Production server ────────────────────────────────────────
# Public URL of the deployed backend (Render gives you this)
PUBLIC_BASE_URL=
# Extra allowed browser origins, comma-separated (e.g. your custom domain)
CORS_ORIGINS=
